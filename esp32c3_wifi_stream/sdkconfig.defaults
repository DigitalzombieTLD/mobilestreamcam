# Target: XIAO ESP32-C3 (RISC-V, 4 MB flash, ~400 KB SRAM, no PSRAM).
# Build with: idf.py set-target esp32c3 && idf.py build
# An existing generated "sdkconfig" overrides these defaults: delete it (and run idf.py fullclean)
# after changing this file. See README.md "RAM budget" for the reason of every option.
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_FREERTOS_HZ=1000

# --- System ---
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_SYSTEM_PANIC_REBOOT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HEAP_POISONING_DISABLED=y
CONFIG_HEAP_TRACING_OFF=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BT_ENABLED=n
# no NVS needed: WiFi config lives in RAM, PHY is fully calibrated at every boot
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

# --- WiFi (STA only) ---
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_FTM_ENABLE=n
CONFIG_ESP_WIFI_DPP_SUPPORT=n
CONFIG_ESP_WIFI_11KV_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_SUITE_B_192=n
CONFIG_ESP_WIFI_GCMP_SUPPORT=n
CONFIG_ESP_WIFI_GMAC_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WIFI_RX_STATS=n
CONFIG_ESP_WIFI_ENABLE_WIFI_TX_STATS=n
# WPA3-SAE (the "SteamCam" network is WPA3-only). Set to n for WPA2-only networks to save RAM.
# WPA2/WPA3 mixed networks work with either setting.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y

# --- lwIP (IPv4 TCP client only) ---
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_DHCPS=n
CONFIG_LWIP_IP_FORWARD=n
CONFIG_LWIP_IPV4_NAPT=n
CONFIG_LWIP_STATS=n
CONFIG_LWIP_BROADCAST_PING=n
CONFIG_LWIP_DHCP_DOES_ARP_CHECK=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=n
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_RECVMBOX_SIZE=6
CONFIG_LWIP_TCP_ACCEPTMBOX_SIZE=2
CONFIG_LWIP_UDP_RECVMBOX_SIZE=6
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=2560
CONFIG_LWIP_TCP_SACK_OUT=n
# httpd needs 3 internal sockets + max_open_sockets (1) = 4, plus one spare
CONFIG_LWIP_MAX_SOCKETS=5
CONFIG_LWIP_MAX_ACTIVE_TCP=8
CONFIG_LWIP_MAX_LISTENING_TCP=2
CONFIG_LWIP_MAX_UDP_PCBS=6

# --- mDNS (optional via CONFIG_MSC_ENABLE_MDNS in main/Kconfig.projbuild) ---
CONFIG_MSC_ENABLE_MDNS=y
CONFIG_MDNS_MAX_SERVICES=1
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n

# SPI slave ISR in IRAM so that DMA transactions are re-armed quickly
CONFIG_SPI_SLAVE_ISR_IN_IRAM=y

# HTTP server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=128
